DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=doc_intake
PORT=3000

# Where uploaded files land on disk. Relative paths resolve
# from the project root. If you run n8n in Docker with a
# volume mount, point both sides at the same absolute path.
UPLOADS_DIR=./uploads
CONFIDENCE_THRESHOLD=0.7
MONEY_TOLERANCE=0.01
